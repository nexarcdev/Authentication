{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Auth": {
    "Issuer": "https://localhost:5001",
    "Audience": "api",
    "Providers": {
      "GoogleWorkspace": {
        "Authority": "https://accounts.google.com",
        "ClientId": "dev-google-client",
        "ClientSecret": "dev-google-secret",
        "AllowedDomains": [ "example.com" ],
        "DevBypass": {
          "Enabled": true,
          "Users": [
            {
              "subject": "google-dev",
              "email": "dev.user@example.com",
              "name": "Google Workspace Dev",
              "roles": [ "Staff" ]
            }
          ]
        }
      },
      "AzureB2C": {
        "Authority": "https://example.b2clogin.com/example.onmicrosoft.com/v2.0/",
        "ClientId": "dev-azureb2c-client",
        "ClientSecret": "dev-azureb2c-secret",
        "AllowedTenants": [],
        "DevBypass": {
          "Enabled": true,
          "Users": [
            {
              "subject": "azureb2c-dev",
              "email": "dev.user@example.com",
              "name": "Azure B2C Dev",
              "roles": [ "Staff" ]
            }
          ]
        }
      },
      "Auth0B2C": {
        "Authority": "https://example.us.auth0.com",
        "ClientId": "dev-auth0-client",
        "ClientSecret": "dev-auth0-secret",
        "AllowedTenants": [],
        "DevBypass": {
          "Enabled": true,
          "Users": [
            {
              "subject": "auth0-dev",
              "email": "dev.user@example.com",
              "name": "Auth0 B2C Dev",
              "roles": [ "Staff" ]
            }
          ]
        }
      },
      "Microsoft365": {
        "Authority": "https://login.microsoftonline.com/common/v2.0",
        "ClientId": "dev-microsoft365-client",
        "ClientSecret": "dev-microsoft365-secret",
        "AllowedTenants": [],
        "DevBypass": {
          "Enabled": true,
          "Users": [
            {
              "subject": "m365-dev",
              "email": "dev.user@example.com",
              "name": "Microsoft 365 Dev",
              "roles": [ "Staff" ]
            }
          ]
        }
      },
      "MagicLink": {
        "RedeemUrl": "https://localhost:5010/magic-link/redeem",
        "DevBypass": {
          "Enabled": true,
          "Destinations": [
            {
              "destination": "dev.user@example.com",
              "user": {
                "subject": "magic-link-dev",
                "email": "dev.user@example.com",
                "name": "Magic Link Dev",
                "roles": [ "Staff" ]
              }
            }
          ]
        }
      },
      "DevicePairing": {
        "PairingUrl": "https://localhost:5012/device-pairing/resolve",
        "DevBypass": {
          "Enabled": true,
          "Devices": [
            {
              "deviceId": "device-123",
              "user": {
                "subject": "device-dev",
                "name": "Paired Device",
                "roles": [ "Device" ]
              }
            }
          ]
        }
      }
    }
  }
}
